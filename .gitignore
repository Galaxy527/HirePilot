# Secrets & local env
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Runtime data (DB, uploads, indexes, checkpoints, outbox)
data/*.db
data/hirepilot.db
data/uploads/**
!data/uploads/.gitkeep
data/faiss/**
!data/faiss/.gitkeep
data/faiss_eval*/
data/checkpoints/**
!data/checkpoints/.gitkeep
data/outbox/**
!data/outbox/.gitkeep

# Logs
logs/**
!logs/.gitkeep

# Raw unredacted captures & eval dumps (may contain PII)
pic/
evals/reports/**
!evals/reports/.gitkeep
docs/screenshots/_preview_*

# Local model / cache noise
*.bin
*.pt
*.onnx
.cache/
