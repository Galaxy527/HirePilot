# Flask
FLASK_SECRET_KEY=change-me-in-production
FLASK_DEBUG=1
DATABASE_URL=sqlite:///data/hirepilot.db
RESUME_SCORE_THRESHOLD=70

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embeddings: local | api | hash
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1

HIRING_INLINE_JOBS=1
PII_RETENTION_DAYS=180
MIN_RETRIEVE_SCORE=0.08
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=5

DEFAULT_ORG_CODE=DEMO
DEFAULT_ORG_NAME=HirePilot Demo Corp
HR_INVITE_CODE=HR-DEMO-2026

MAIL_LOG_ONLY=1
MAIL_ENABLED=0
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@hirepilot.local
SMS_LOG_ONLY=1
SMS_ENABLED=0
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
APP_PUBLIC_URL=http://127.0.0.1:5000

RATELIMIT_AUTH=20 per minute
RATELIMIT_UPLOAD=10 per minute
RATELIMIT_CHAT=30 per minute

UPLOAD_FOLDER=data/uploads
FAISS_INDEX_DIR=data/faiss
CHECKPOINT_DB=data/checkpoints/langgraph.db
LOG_DIR=logs
OUTBOX_DIR=data/outbox
